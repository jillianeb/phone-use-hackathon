# npm run sms explicitly reads an optional .env file. npm start uses the current environment.
# Never commit actual credentials.
ANTHROPIC_API_KEY=
# Use a vision/tool-capable model ID available to your account.
ANTHROPIC_MODEL=

# Hosted PhoneUse:
PHONEUSE_API_KEY=
PHONEUSE_MCP_URL=https://mcp.phoneuse.com/mcp
# Set the ID of your authorized phone, especially when more than one is visible.
PHONEUSE_DEVICE_ID=

# OR local PhoneUse repository (API and WebDriverAgent must already be running):
# PHONEUSE_MCP_COMMAND=/absolute/path/to/phoneuse/platform/start-mcp.sh
# PHONEUSE_MCP_ARGS=[]

# Real SMS (separate service: npm run sms). Do not put real values in this template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS origin reaching sms-server.mjs, not the private static Site URL.
SMS_PUBLIC_BASE_URL=
# Explicit approved test-user phone -> their dedicated PhoneUse device ID.
# Example only: {"+15551234567":"your-device-id"}
SMS_BINDINGS_JSON={}
SMS_PORT=3111
SMS_BIND_HOST=127.0.0.1
SMS_STATE_DIR=.state
